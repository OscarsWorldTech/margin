# Hardware: compose.prebuilt.yml (Intel/AMD), compose.prebuilt.nvidia.yml, or compose.prebuilt.cpu.yml.
# setup.sh sets this choice; CPU works without GPU passthrough or drivers.
COMPOSE_FILE=compose.prebuilt.cpu.yml
# Explicit release version: change deliberately when upgrading.
MARGIN_VERSION=v0.1.5
MARGIN_IMAGE_BASE=ghcr.io/oscarsworldtech/margin

# URL reachable from inside the Margin container (include any ABS subpath).
ABS_URL=https://audiobookshelf.example.com
ABS_TOKEN=replace-with-your-audiobookshelf-api-token
MARGIN_PASSWORD=replace-with-a-long-unique-password

# Intel/AMD only. Find this in the Linux VM: stat -c '%g' /dev/dri/renderD128
RENDER_GID=replace-with-the-number-from-stat
# NVIDIA only: GPU index or UUID from nvidia-smi (default: first GPU).
NVIDIA_GPU_ID=0
WHISPER_THREADS=4
WHISPER_MODEL=small.en
WHISPER_LANGUAGE=en

# Keep loopback for a same-host HTTPS proxy. See docs/HTTPS.md before LAN access.
BIND_ADDRESS=127.0.0.1
# Secure cookies for HTTPS, including older published images. auto is supported by hardened builds.
COOKIE_SECURE=true
# Exact proxy socket IPs, comma-separated. The proxy must overwrite forwarding headers.
TRUSTED_PROXIES=
# Explicit acknowledgement only for isolated/trusted HTTP networks. Does not add encryption.
ALLOW_INSECURE_HTTP=false
# Optional comma-separated external origins when reverse proxy changes Host.
ALLOWED_ORIGINS=
